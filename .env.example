# development, production, test
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# sqlite URL. A relative path is resolved from the project root.
DATABASE_URL=sqlite:///./data/approvals.db

LOG_LEVEL=INFO
IS_DEBUG=True

# Slack app. Leave blank until the app is installed.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Inbound X-API-Key. Replace before any shared demo.
PROXY_API_KEY=erp-system-secret-key-123
